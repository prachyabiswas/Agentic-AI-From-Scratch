# Copy this file to .env and fill in your own keys. Never commit the real .env file.

# Get a free key from https://aistudio.google.com/ (click "API keys")
GOOGLE_API_KEY=your_google_api_key_here

# Get a free key from https://console.groq.com/ (used as a backup / alternative provider)
GROQ_API_KEY=your_groq_api_key_here

# Optional — only needed if you want LangSmith tracing/observability
LANGSMITH_API_KEY=your_langsmith_api_key_here
